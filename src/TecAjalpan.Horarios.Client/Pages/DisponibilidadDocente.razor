@page "/disponibilidad"
@attribute [Authorize(Roles = "Administrador,Secretaría,Jefatura,Subdirección Académica")]
@inject DocentesApi DocentesApi
@inject AuthenticationStateProvider AuthenticationStateProvider

<PageTitle>Disponibilidad docente | Horarios Tec Ajalpan</PageTitle>

<div class="page-heading">
  <div>
    <span class="eyebrow">Recursos académicos</span>
    <h1>Disponibilidad docente</h1>
    <p>Registra la jornada de permanencia y las ventanas disponibles para impartir clases por periodo.</p>
  </div>
</div>

@if (!string.IsNullOrWhiteSpace(mensaje))
{
  <div class="alerta-exito">@mensaje</div>
}
@if (!string.IsNullOrWhiteSpace(error))
{
  <div class="alerta-error">@error</div>
}

<article class="panel">
  <div class="availability-filters">
    <div class="form-field">
      <label for="periodo">Periodo</label>
      <select id="periodo" @bind="periodoId" @bind:after="CargarDisponibilidad">
        <option value="@Guid.Empty">Selecciona un periodo</option>
        @foreach (var periodo in periodos)
        {
          <option value="@periodo.Id">@periodo.Nombre</option>
        }
      </select>
      @if (periodos.Count == 0)
      {
        <small>No hay un periodo activo disponible para captura.</small>
      }
    </div>
    <div class="form-field">
      <label for="docente">Docente</label>
      <select id="docente" @bind="docenteId" @bind:after="CargarDisponibilidad">
        <option value="@Guid.Empty">Selecciona un docente</option>
        @foreach (var docente in docentes.Where(x => x.Activo))
        {
          <option value="@docente.Id">@docente.Apellidos, @docente.Nombres</option>
        }
      </select>
    </div>
  </div>
</article>

@if (cargando)
{
  <div class="table-state">Cargando…</div>
}
else if (modelo is not null && DocenteSeleccionado is not null)
{
  <article class="panel availability-panel">
    <div class="panel-title">
      <div>
        <h2>@DocenteSeleccionado.Apellidos, @DocenteSeleccionado.Nombres</h2>
        <p>@DocenteSeleccionado.TipoNombre · @CarreraPrincipal</p>
      </div>
      <span class="status @(modelo.Validada ? "status-active" : "status-closed")">
        @(modelo.Validada ? "Validada" : "Pendiente de validación")
      </span>
    </div>

    @if (DocenteSeleccionado.Tipo == 1)
    {
      <h3>Jornada de permanencia</h3>
      <p class="form-help">
        La jornada ordinaria debe sumar 40 horas de lunes a viernes, sin superar 8 horas
        por día. Si imparte un módulo sabatino, también se registra el perfil que aplicará
        únicamente durante sus 5 o 6 semanas.
      </p>
      <h4>Semana ordinaria</h4>
      <div class="workday-grid">
        @foreach (var dia in DiasLaborales)
        {
          var jornada = ObtenerJornada(dia.Id, esSemanaSabatina: false);
          var horasDia = CalcularHoras(jornada);
          <div class="workday-row">
            <strong>@dia.Nombre</strong>
            <label>
              Entrada
              <input type="time" min="07:00" max="17:00"
                     value="@jornada.HoraInicio.ToString("HH:mm", CultureInfo.InvariantCulture)"
                     @onchange="e => CambiarHora(dia.Id, false, true, e.Value?.ToString())" />
            </label>
            <label>
              Salida
              <input type="time" min="08:00" max="18:00"
                     value="@jornada.HoraFin.ToString("HH:mm", CultureInfo.InvariantCulture)"
                     @onchange="e => CambiarHora(dia.Id, false, false, e.Value?.ToString())" />
            </label>
            <span>@FormatearHoras(horasDia)</span>
          </div>
        }
      </div>
      <div class="workweek-total @(TotalHorasJornada(false) == 40 ? "is-valid" : "is-invalid")">
        <span>Total de semana ordinaria</span>
        <strong>@FormatearHoras(TotalHorasJornada(false)) / 40 horas</strong>
      </div>

      <label class="saturday-workday-toggle">
        <input type="checkbox"
               checked="@TienePerfilSabatino"
               @onchange="AlternarPerfilSabatino" />
        <span>
          <strong>El docente impartirá un módulo sabatino</strong>
          <small>
            Habilita una segunda jornada que sólo se aplicará en las fechas del módulo asignado.
          </small>
        </span>
      </label>

      @if (TienePerfilSabatino)
      {
        <h4>Semana durante el módulo sabatino</h4>
        <p class="form-help">
          Debe sumar 40 horas: 36 de lunes a viernes y un turno sabatino de 4 horas,
          de 08:00–12:00 o de 12:00–16:00.
        </p>
        <div class="workday-grid">
        @foreach (var dia in Dias)
        {
          var jornada = ObtenerJornada(dia.Id, esSemanaSabatina: true);
          var horasDia = CalcularHoras(jornada);
          <div class="workday-row">
            <strong>@dia.Nombre</strong>
            <label>
              Entrada
              <input type="time"
                     min="@(dia.Id == 6 ? "08:00" : "07:00")"
                     max="@(dia.Id == 6 ? "12:00" : "17:00")"
                     value="@jornada.HoraInicio.ToString("HH:mm", CultureInfo.InvariantCulture)"
                     @onchange="e => CambiarHora(dia.Id, true, true, e.Value?.ToString())" />
            </label>
            <label>
              Salida
              <input type="time"
                     min="@(dia.Id == 6 ? "12:00" : "08:00")"
                     max="@(dia.Id == 6 ? "16:00" : "18:00")"
                     value="@jornada.HoraFin.ToString("HH:mm", CultureInfo.InvariantCulture)"
                     @onchange="e => CambiarHora(dia.Id, true, false, e.Value?.ToString())" />
            </label>
            <span>@FormatearHoras(horasDia)</span>
          </div>
        }
        </div>
        <div class="workweek-total @(TotalHorasJornada(true) == 40 ? "is-valid" : "is-invalid")">
          <span>Total durante el módulo</span>
          <strong>@FormatearHoras(TotalHorasJornada(true)) / 40 horas</strong>
        </div>
      }
    }

    @if (DocenteSeleccionado.Tipo == 2)
    {
      <h3>Disponibilidad para clases (08:00–16:00)</h3>
      <p class="form-help">
        Selecciona las horas reales del docente. Puedes pulsar cualquier parte de la celda;
        el generador dará prioridad a asignatura y compactará sus clases para reducir días y huecos.
      </p>
      <div class="availability-table-wrap">
        <table class="availability-table">
          <thead>
            <tr>
              <th scope="col">Hora</th>
              @foreach (var dia in Dias)
              {
                <th scope="col">@dia.Nombre</th>
              }
            </tr>
          </thead>
          <tbody>
            @for (byte bloque = 1; bloque <= 8; bloque++)
            {
              var bloqueLocal = bloque;
              <tr>
                <th scope="row">@Horas[bloqueLocal - 1]</th>
                @foreach (var dia in Dias)
                {
                  var diaLocal = dia;
                  var seleccionada = EstaDisponible(diaLocal.Id, bloqueLocal);
                  <td class="availability-cell-container">
                    <button type="button"
                            class="availability-cell @(seleccionada ? "is-selected" : null)"
                            aria-pressed="@seleccionada"
                            title="@($"{diaLocal.Nombre}, {Horas[bloqueLocal - 1]}")"
                            @onclick="() => AlternarBloque(diaLocal.Id, bloqueLocal)">
                      <span class="availability-check" aria-hidden="true">✓</span>
                      <span class="visually-hidden">
                        @(seleccionada ? "Disponible" : "No disponible")
                      </span>
                    </button>
                  </td>
                }
              </tr>
            }
          </tbody>
        </table>
      </div>
    }

    <div class="modal-actions">
      @if (puedeCapturar)
      {
        <button class="btn-primary" disabled="@procesando" @onclick="Guardar">
          @(procesando
            ? "Guardando…"
            : DocenteSeleccionado.Tipo == 1
              ? "Guardar jornada"
              : "Guardar disponibilidad")
        </button>
      }
      @if (puedeValidar && !modelo.Validada && !string.IsNullOrWhiteSpace(modelo.RowVersion))
      {
        <button class="btn-secondary" disabled="@procesando" @onclick="Validar">
          Validar disponibilidad
        </button>
      }
    </div>
  </article>
}

@code {
  private static readonly (byte Id, string Nombre)[] Dias =
  [
    (1, "Lunes"), (2, "Martes"), (3, "Miércoles"),
    (4, "Jueves"), (5, "Viernes"), (6, "Sábado")
  ];
  private static readonly string[] Horas =
  [
    "08–09", "09–10", "10–11", "11–12",
    "12–13", "13–14", "14–15", "15–16"
  ];

  private List<DocenteDto> docentes = [];
  private List<PeriodoDto> periodos = [];
  private DisponibilidadDocenteDto? modelo;
  private Guid docenteId;
  private Guid periodoId;
  private bool cargando = true;
  private bool procesando;
  private bool puedeCapturar;
  private bool puedeValidar;
  private string? mensaje;
  private string? error;

  private IEnumerable<(byte Id, string Nombre)> DiasLaborales => Dias.Take(5);
  private bool TienePerfilSabatino =>
    modelo?.Jornadas.Any(x => x.EsSemanaSabatina) == true;
  private double TotalHorasJornada(bool esSemanaSabatina) =>
    modelo?.Jornadas
      .Where(x => x.EsSemanaSabatina == esSemanaSabatina)
      .Sum(CalcularHoras) ?? 0;
  private DocenteDto? DocenteSeleccionado => docentes.SingleOrDefault(x => x.Id == docenteId);
  private string CarreraPrincipal =>
    DocenteSeleccionado?.Carreras.SingleOrDefault(x => x.EsPrincipal)?.Nombre
    ?? "Sin carrera de adscripción";

  protected override async Task OnInitializedAsync()
  {
    try
    {
      var auth = await AuthenticationStateProvider.GetAuthenticationStateAsync();
      puedeCapturar = auth.User.IsInRole("Administrador") || auth.User.IsInRole("Secretaría");
      puedeValidar = auth.User.IsInRole("Administrador") || auth.User.IsInRole("Jefatura");
      var docentesTask = DocentesApi.ListarAsync();
      var periodosTask = DocentesApi.ListarPeriodosDisponiblesAsync();
      await Task.WhenAll(docentesTask, periodosTask);
      docentes = (await docentesTask).ToList();
      periodos = (await periodosTask).Where(x => x.Estado == 2).ToList();
    }
    catch (Exception ex)
    {
      error = $"No fue posible cargar los catálogos: {ex.Message}";
    }
    finally
    {
      cargando = false;
    }
  }

  private async Task CargarDisponibilidad()
  {
    mensaje = null;
    error = null;
    modelo = null;
    if (docenteId == Guid.Empty || periodoId == Guid.Empty)
    {
      return;
    }

    cargando = true;
    try
    {
      modelo = await DocentesApi.ObtenerDisponibilidadAsync(docenteId, periodoId);
      if (modelo is not null && modelo.TipoDocente == 1 && modelo.Jornadas.Count == 0)
      {
        modelo = modelo with
        {
          Jornadas = DiasLaborales
            .Select(x => JornadaPredeterminada(x.Id, esSemanaSabatina: false))
            .ToArray()
        };
      }
    }
    catch (Exception ex)
    {
      error = $"No fue posible cargar la disponibilidad: {ex.Message}";
    }
    finally
    {
      cargando = false;
    }
  }

  private JornadaDocenteDto ObtenerJornada(byte dia, bool esSemanaSabatina) =>
    modelo?.Jornadas.SingleOrDefault(
      x => x.Dia == dia && x.EsSemanaSabatina == esSemanaSabatina)
    ?? JornadaPredeterminada(dia, esSemanaSabatina);

  private void CambiarHora(
    byte dia,
    bool esSemanaSabatina,
    bool inicio,
    string? valor)
  {
    if (modelo is null
        || !TimeOnly.TryParse(
          valor,
          CultureInfo.InvariantCulture,
          DateTimeStyles.None,
          out var hora))
    {
      return;
    }
    var jornadas = modelo.Jornadas.ToList();
    var indice = jornadas.FindIndex(
      x => x.Dia == dia && x.EsSemanaSabatina == esSemanaSabatina);
    var actual = indice >= 0
      ? jornadas[indice]
      : JornadaPredeterminada(dia, esSemanaSabatina);
    var nueva = inicio
      ? actual with { HoraInicio = hora }
      : actual with { HoraFin = hora };
    if (indice >= 0)
    {
      jornadas[indice] = nueva;
    }
    else
    {
      jornadas.Add(nueva);
    }
    modelo = modelo with { Jornadas = jornadas, Validada = false };
  }

  private void AlternarPerfilSabatino(ChangeEventArgs args)
  {
    if (modelo is null)
    {
      return;
    }

    var incluir = args.Value is true
      || bool.TryParse(args.Value?.ToString(), out var valor) && valor;
    var jornadas = modelo.Jornadas
      .Where(x => !x.EsSemanaSabatina)
      .ToList();
    if (incluir)
    {
      foreach (var dia in DiasLaborales)
      {
        var ordinaria = ObtenerJornada(dia.Id, esSemanaSabatina: false);
        var fin = dia.Id == 5
          ? ordinaria.HoraInicio.AddHours(4)
          : ordinaria.HoraFin;
        jornadas.Add(new JornadaDocenteDto(
          dia.Id,
          ordinaria.HoraInicio,
          fin,
          EsSemanaSabatina: true));
      }
      jornadas.Add(JornadaPredeterminada(6, esSemanaSabatina: true));
    }

    modelo = modelo with { Jornadas = jornadas, Validada = false };
  }

  private static JornadaDocenteDto JornadaPredeterminada(
    byte dia,
    bool esSemanaSabatina) =>
    dia == 6
      ? new JornadaDocenteDto(
          dia,
          new TimeOnly(8, 0),
          new TimeOnly(12, 0),
          esSemanaSabatina)
      : new JornadaDocenteDto(
          dia,
          new TimeOnly(8, 0),
          new TimeOnly(16, 0),
          esSemanaSabatina);

  private static double CalcularHoras(JornadaDocenteDto jornada) =>
    Math.Max(0, (jornada.HoraFin - jornada.HoraInicio).TotalHours);

  private static string FormatearHoras(double horas) =>
    horas == 1 ? "1 hora" : $"{horas:0.##} horas";

  private bool EstaDisponible(byte dia, byte bloque) =>
    modelo?.Bloques.Any(x => x.Dia == dia && x.Bloque == bloque) == true;

  private void AlternarBloque(byte dia, byte bloque)
  {
    if (modelo is null)
    {
      return;
    }

    var bloques = modelo.Bloques.ToList();
    var estabaDisponible = bloques.RemoveAll(
      x => x.Dia == dia && x.Bloque == bloque) > 0;
    if (!estabaDisponible)
    {
      bloques.Add(new DisponibilidadBloqueDto(dia, bloque, false));
    }

    modelo = modelo with { Bloques = bloques, Validada = false };
  }

  private async Task Guardar()
  {
    if (modelo is null)
    {
      return;
    }
    procesando = true;
    error = null;
    try
    {
      var request = new GuardarDisponibilidadDocenteRequest
      {
        PeriodoId = periodoId,
        Jornadas = DocenteSeleccionado?.Tipo == 1
          ? modelo.Jornadas.ToList()
          : [],
        Bloques = DocenteSeleccionado?.Tipo == 2
          ? modelo.Bloques.ToList()
          : [],
        RowVersion = modelo.RowVersion
      };
      var resultado = await DocentesApi.GuardarDisponibilidadAsync(
        docenteId, periodoId, request);
      if (!resultado.Correcto || resultado.Disponibilidad is null)
      {
        error = resultado.Mensaje;
        return;
      }
      modelo = resultado.Disponibilidad;
      mensaje = "Disponibilidad guardada. Jefatura debe validarla antes de generar horarios.";
    }
    catch (Exception ex)
    {
      error = $"No fue posible guardar la disponibilidad: {ex.Message}";
    }
    finally
    {
      procesando = false;
    }
  }

  private async Task Validar()
  {
    if (modelo is null)
    {
      return;
    }
    procesando = true;
    error = null;
    try
    {
      var resultado = await DocentesApi.ValidarDisponibilidadAsync(modelo);
      if (!resultado.Correcto || resultado.Disponibilidad is null)
      {
        error = resultado.Mensaje;
        return;
      }
      modelo = resultado.Disponibilidad;
      mensaje = "Disponibilidad validada correctamente.";
    }
    catch (Exception ex)
    {
      error = $"No fue posible validar la disponibilidad: {ex.Message}";
    }
    finally
    {
      procesando = false;
    }
  }
}
