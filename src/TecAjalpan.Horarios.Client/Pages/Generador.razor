@page "/generador"
@attribute [Authorize(Roles = "Administrador,Jefatura")]
@inject HorariosApi HorariosApi

<PageTitle>Generador | Horarios Tec Ajalpan</PageTitle>

<div class="page-heading">
  <div>
    <span class="eyebrow">Planeación institucional</span>
    <h1>Generador de horarios</h1>
    <p>Construye una propuesta conjunta para todas las carreras, sin cruces de docentes, grupos ni aulas compartidas.</p>
  </div>
</div>

@if (!string.IsNullOrWhiteSpace(error))
{
  <div class="alerta-error">@error</div>
}
@if (!string.IsNullOrWhiteSpace(mensaje))
{
  <div class="alerta-exito">@mensaje</div>
}

<div class="generador-grid">
  <article class="panel generador-configuracion">
    <div class="panel-title">
      <div>
        <span class="eyebrow">Nueva ejecución</span>
        <h2>Generar propuesta</h2>
      </div>
    </div>

    @if (cargando)
    {
      <div class="table-state">Cargando periodos…</div>
    }
    else
    {
      <div class="form-field">
        <label for="periodo-generador">Periodo</label>
        <InputSelect id="periodo-generador" @bind-Value="periodoId"
                     @bind-Value:after="OnPeriodoChanged">
          <option value="@Guid.Empty">Selecciona un periodo</option>
          @foreach (var periodo in periodos)
          {
            <option value="@periodo.Id">@periodo.Nombre · @periodo.EstadoTexto</option>
          }
        </InputSelect>
      </div>

      <div class="form-field">
        <label for="limite-generador">Tiempo de optimización (segundos)</label>
        <InputNumber id="limite-generador" @bind-Value="tiempoLimiteSegundos"
                     min="10" max="600" />
        <div class="generador-tiempo-ayuda">
          <strong>60 segundos es el valor recomendado.</strong>
          <span><b>10</b> termina más rápido, pero explora menos alternativas. <b>600</b> le permite buscar hasta 10 minutos una distribución con menos huecos.</span>
          <small>Este valor no cambia las horas de clase: solo limita cuánto tiempo puede trabajar el generador y siempre conserva la mejor solución encontrada.</small>
        </div>
      </div>

      <div class="generador-aviso">
        <strong>Alcance institucional</strong>
        <p>Se incluirán todas las cargas autorizadas del periodo. La generación no separa carreras porque debe proteger docentes y espacios compartidos.</p>
      </div>

      <button class="btn-primary generador-boton" disabled="@NoPuedeGenerar" @onclick="Generar">
        @(generando ? "Generando propuesta…" : "Generar horario")
      </button>
    }
  </article>

  <article class="panel generador-resultado">
    @if (resultado is null && versionActual is null)
    {
      <div class="empty-state compact">
        <div class="empty-icon">⌁</div>
        <h2>Sin ejecución reciente</h2>
        <p>Autoriza las cargas académicas y genera la primera versión en borrador.</p>
      </div>
    }
    else
    {
      <div class="panel-title">
        <div>
          <span class="eyebrow">Versión @NumeroVersion</span>
          <h2>@(Completa ? "Propuesta completa" : "Propuesta parcial")</h2>
        </div>
        <span class="status @(Completa ? "status-active" : "status-draft")">
          @(Completa ? "Sin pendientes" : $"{NumeroPendientes} pendiente(s)")
        </span>
      </div>

      <div class="generador-metricas">
        <div><span>Horas solicitadas</span><strong>@HorasSolicitadas</strong></div>
        <div><span>Horas programadas</span><strong>@HorasProgramadas</strong></div>
        <div><span>Sesiones fechadas</span><strong>@SesionesGeneradas</strong></div>
        <div><span>Cobertura</span><strong>@Cobertura.ToString("0.#")%</strong></div>
      </div>

      <div class="generador-acciones">
        @if (versionActual is not null)
        {
          <div class="generador-guardado">
            <strong>Propuesta lista para revisión</strong>
            <small>Guardada @versionActual.FechaCreacion.ToLocalTime().ToString("dd/MM/yyyy HH:mm") · @versionActual.EstadoTexto</small>
          </div>
        }
        <div class="generador-botones-resultado">
          @if (versionActual?.Estado == 1)
          {
            <button class="btn-descartar" type="button" disabled="@descartando"
                    @onclick="ConfirmarDescarte">
              Descartar versión
            </button>
          }
          <a class="btn-primary" href="@($"/horario/{HorarioVersionId}")">Ver horario generado</a>
        </div>
      </div>

      @if (resultado is not null && resultado.Pendientes.Count > 0)
      {
        <div class="generador-pendientes">
          <h3>Elementos que requieren ajuste</h3>
          @foreach (var pendiente in resultado.Pendientes)
          {
            <div class="generador-pendiente">
              <span>@pendiente.Codigo.Replace('_', ' ')</span>
              <strong>@pendiente.Horas h</strong>
              <p>@pendiente.Detalle</p>
            </div>
          }
        </div>
      }


      @if (versiones.Count > 1)
      {
        <div class="generador-versiones">
          <h3>Versiones recientes</h3>
          @foreach (var version in versiones.Skip(1))
          {
            <a href="@($"/horario/{version.Id}")">
              <span>Versión @version.Numero · @version.EstadoTexto</span>
              <small>@version.FechaCreacion.ToLocalTime().ToString("dd/MM/yyyy HH:mm")</small>
            </a>
          }
        </div>
      }
    }
  </article>
</div>

@if (mostrarConfirmacionDescartar && versionActual is not null)
{
  <div class="modal-backdrop" @onclick="CerrarConfirmacionDescarte">
    <section class="modal-card confirm-card" role="alertdialog" aria-modal="true"
             aria-labelledby="titulo-descartar-horario" @onclick:stopPropagation>
      <div class="modal-header">
        <div>
          <span class="eyebrow">Confirmar descarte</span>
          <h2 id="titulo-descartar-horario">Descartar versión @versionActual.Numero</h2>
        </div>
        <button class="icon-button" type="button" disabled="@descartando"
                @onclick="CerrarConfirmacionDescarte">×</button>
      </div>
      <p>Esta propuesta dejará de aparecer como horario activo y no podrá aprobarse ni publicarse.</p>
      <p class="modal-help">La versión se conservará en la auditoría y su número no se reutilizará.</p>
      @if (!string.IsNullOrWhiteSpace(error))
      {
        <div class="alerta-error">@error</div>
      }
      <div class="modal-actions">
        <button class="btn-ghost" type="button" disabled="@descartando"
                @onclick="CerrarConfirmacionDescarte">Cancelar</button>
        <button class="btn-danger" type="button" disabled="@descartando" @onclick="DescartarVersion">
          @(descartando ? "Descartando…" : "Sí, descartar versión")
        </button>
      </div>
    </section>
  </div>
}

@if (Ocupado)
{
  <div class="loading-overlay" role="status" aria-live="polite" aria-busy="true">
    <div class="loading-card generador-loading-card">
      <span class="loading-spinner"></span>
      <strong>@TextoCarga</strong>
      <small>@DetalleCarga</small>
      @if (generando)
      {
        <span class="loading-hint">
          Tiempo máximo configurado: @TiempoLimiteTexto. No cierres esta ventana.
        </span>
      }
    </div>
  </div>
}

@code {
  private List<PeriodoGeneracionDto> periodos = [];
  private Guid periodoId;
  private int tiempoLimiteSegundos = 60;
  private bool cargando = true;
  private bool generando;
  private bool descartando;
  private bool mostrarConfirmacionDescartar;
  private string? error;
  private string? mensaje;
  private ResultadoGeneracionDto? resultado;
  private List<HorarioVersionResumenDto> versiones = [];
  private HorarioVersionResumenDto? versionActual => versiones.FirstOrDefault();

  private bool Ocupado => cargando || generando || descartando;
  private string TextoCarga => generando
    ? "Generando y compactando el horario…"
    : descartando
      ? "Descartando la versión…"
      : "Cargando el generador de horarios…";
  private string DetalleCarga => generando
    ? "Revisando disponibilidad, cruces de docentes, grupos, aulas compartidas y espacios libres."
    : descartando
      ? "Actualizando las versiones disponibles."
      : "Consultando periodos y propuestas guardadas.";
  private string TiempoLimiteTexto => tiempoLimiteSegundos < 60
    ? $"{tiempoLimiteSegundos} segundos"
    : tiempoLimiteSegundos == 60
      ? "1 minuto"
      : $"{tiempoLimiteSegundos / 60d:0.#} minutos";
  private bool NoPuedeGenerar => generando || periodoId == Guid.Empty;
  private Guid HorarioVersionId => resultado?.HorarioVersionId ?? versionActual?.Id ?? Guid.Empty;
  private int NumeroVersion => resultado?.NumeroVersion ?? versionActual?.Numero ?? 0;
  private bool Completa => resultado?.Completa ?? versionActual?.Completa ?? false;
  private int HorasSolicitadas => resultado?.HorasSolicitadas ?? versionActual?.HorasSolicitadas ?? 0;
  private int HorasProgramadas => resultado?.HorasProgramadas ?? versionActual?.HorasProgramadas ?? 0;
  private int SesionesGeneradas => resultado?.SesionesGeneradas ?? versionActual?.SesionesGeneradas ?? 0;
  private int NumeroPendientes => resultado?.Pendientes.Count ?? versionActual?.NumeroPendientes ?? 0;
  private decimal Cobertura => HorasSolicitadas == 0
    ? 0
    : decimal.Divide(HorasProgramadas * 100, HorasSolicitadas);

  protected override async Task OnInitializedAsync()
  {
    try
    {
      periodos = (await HorariosApi.ListarPeriodosAsync()).ToList();
      periodoId = periodos.FirstOrDefault(x => x.Estado == 2)?.Id
        ?? periodos.FirstOrDefault()?.Id
        ?? Guid.Empty;
      await CargarVersiones();
    }
    catch (Exception ex)
    {
      error = ex.Message;
    }
    finally
    {
      cargando = false;
    }
  }

  private async Task OnPeriodoChanged()
  {
    cargando = true;
    resultado = null;
    mensaje = null;
    error = null;
    await Task.Yield();
    try
    {
      await CargarVersiones();
    }
    catch (Exception ex)
    {
      error = ex.Message;
    }
    finally
    {
      cargando = false;
    }
  }

  private async Task CargarVersiones()
  {
    versiones = periodoId == Guid.Empty
      ? []
      : (await HorariosApi.ListarVersionesAsync(periodoId)).ToList();
  }

  private async Task Generar()
  {
    if (NoPuedeGenerar)
      return;

    generando = true;
    error = null;
    mensaje = null;
    resultado = null;
    await Task.Yield();
    try
    {
      var respuesta = await HorariosApi.GenerarAsync(new GenerarHorarioRequest(
        periodoId,
        Math.Clamp(tiempoLimiteSegundos, 10, 600)));
      if (!respuesta.Correcto || respuesta.Resultado is null)
      {
        error = respuesta.Mensaje ?? "No fue posible generar el horario.";
        return;
      }

      resultado = respuesta.Resultado;
      await CargarVersiones();
      mensaje = resultado.Completa
        ? $"La versión {resultado.NumeroVersion} se guardó completa en borrador."
        : $"La versión {resultado.NumeroVersion} se guardó con pendientes para revisión.";
    }
    catch (Exception ex)
    {
      error = ex.Message;
    }
    finally
    {
      generando = false;
    }
  }

  private void ConfirmarDescarte() => mostrarConfirmacionDescartar = true;

  private void CerrarConfirmacionDescarte()
  {
    if (!descartando)
      mostrarConfirmacionDescartar = false;
  }

  private async Task DescartarVersion()
  {
    if (versionActual is null || descartando)
      return;

    var numero = versionActual.Numero;
    descartando = true;
    error = null;
    mensaje = null;
    try
    {
      var respuesta = await HorariosApi.DescartarAsync(versionActual.Id);
      if (!respuesta.Correcto)
      {
        error = respuesta.Mensaje ?? "No fue posible descartar la versión.";
        return;
      }

      resultado = null;
      mostrarConfirmacionDescartar = false;
      await CargarVersiones();
      mensaje = $"La versión {numero} fue descartada y permanece disponible en la auditoría.";
    }
    catch (Exception ex)
    {
      error = ex.Message;
    }
    finally
    {
      descartando = false;
    }
  }
}
