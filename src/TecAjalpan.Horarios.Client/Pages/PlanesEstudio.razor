@page "/planes-estudio"
@attribute [Authorize(Roles = "Administrador,Secretaría,Jefatura,Subdirección Académica")]
@inject PlanesEstudioApi Api
@inject CarrerasApi CarrerasApi
@inject AuthenticationStateProvider AuthenticationStateProvider

<PageTitle>Materias | Horarios Tec Ajalpan</PageTitle>

<div class="page-heading">
  <div>
    <span class="eyebrow">Configuración académica</span>
    <h1>Materias por plan de estudios</h1>
    <p>Selecciona la carrera y la retícula para administrar sus materias por semestre.</p>
  </div>
  @if (esAdministrador && reticulaId != Guid.Empty)
  {
    <button class="btn-primary" @onclick="NuevaMateria" disabled="@Ocupado">+ Nueva materia</button>
  }
</div>

@if (!string.IsNullOrWhiteSpace(mensaje)) { <div class="alerta-exito">@mensaje</div> }
@if (!string.IsNullOrWhiteSpace(error)) { <div class="alerta-error">@error</div> }

<article class="panel">
  <div class="form-grid">
    <div class="form-field">
      <label for="carrera-materia">Carrera</label>
      <select id="carrera-materia" value="@carreraId" @onchange="CambiarCarrera" disabled="@Ocupado">
        <option value="@Guid.Empty">Selecciona…</option>
        @foreach (var c in carreras.Where(x => x.Activo))
        {
          <option value="@c.Id">@c.Clave — @c.Nombre</option>
        }
      </select>
    </div>
    <div class="form-field">
      <label for="reticula-materia">Retícula</label>
      <select id="reticula-materia" value="@reticulaId" @onchange="CambiarReticula"
              disabled="@(carreraId == Guid.Empty || cargandoReticulas || procesando)">
        <option value="@Guid.Empty">@(cargandoReticulas ? "Cargando retículas…" : "Selecciona…")</option>
        @foreach (var r in reticulas)
        {
          <option value="@r.Id">@r.Clave — @r.Nombre @(!r.Activo ? "(Inactiva)" : "")</option>
        }
      </select>
      @if (cargandoReticulas) { <small class="loading-hint">Actualizando retículas…</small> }
    </div>
    <div class="form-field">
      <label for="semestre-materia">Semestre</label>
      <select id="semestre-materia" @bind="semestre"
              disabled="@(reticulaId == Guid.Empty || cargandoMaterias || procesando)">
        <option value="0">Todos</option>
        @for (var i = 1; i <= 9; i++) { <option value="@i">@i</option> }
      </select>
    </div>
  </div>
</article>

@if (reticulaId == Guid.Empty)
{
  <article class="panel empty-state">
    <h2>Selecciona un plan de estudios</h2>
    <p>Las materias se mostrarán después de elegir una carrera y una retícula.</p>
  </article>
}
else
{
  <article class="panel catalogo-panel">
    <div class="toolbar">
      <label class="search-box"><span>Buscar materia</span><input @bind="filtro" @bind:event="oninput" placeholder="Clave o nombre…" disabled="@Ocupado" /></label>
      <span class="record-count">@MateriasFiltradas.Count() materia(s) · @MateriasFiltradas.Sum(x => x.HorasSemanales) horas</span>
    </div>
    @if (cargandoMaterias)
    {
      <div class="empty-state compact"><h2>Cargando materias…</h2><p>Espera mientras se actualiza el plan seleccionado.</p></div>
    }
    else if (!MateriasFiltradas.Any())
    {
      <div class="empty-state compact"><h2>Sin materias</h2><p>No hay materias que coincidan con la selección actual.</p></div>
    }
    else
    {
      <div class="table-responsive">
        <table class="data-table">
          <thead><tr><th>Clave</th><th>Materia</th><th>Sem.</th><th>Teoría</th><th>Práctica</th><th>Total</th><th>Créditos</th><th>Modalidades</th><th>Estado</th>@if(esAdministrador){<th>Acciones</th>}</tr></thead>
          <tbody>
          @foreach (var m in MateriasFiltradas)
          {
            <tr class="@(!m.Activo ? "row-inactive" : null)">
              <td><strong>@m.Clave</strong></td><td>@m.Nombre</td><td>@m.Semestre</td>
              <td>@m.HorasTeoricas</td><td>@m.HorasPracticas</td><td><strong>@m.HorasSemanales</strong></td><td>@m.Creditos</td>
              <td>@string.Join(", ", m.Modalidades.Select(x => x.Nombre))</td>
              <td><span class="status @(m.Activo ? "status-active" : "status-closed")">@(m.Activo ? "Activa" : "Inactiva")</span></td>
              @if(esAdministrador){<td class="catalogo-actions"><button class="btn-link" @onclick="() => EditarMateria(m)" disabled="@Ocupado">Editar</button><button class="btn-link" @onclick="() => CambiarEstadoMateria(m)" disabled="@Ocupado">@(m.Activo ? "Desactivar" : "Activar")</button></td>}
            </tr>
          }
          </tbody>
        </table>
      </div>
    }
  </article>
}

@if (mostrarMateria)
{
  <div class="modal-backdrop"><section class="modal-card"><div class="modal-header"><h2>@(materiaEditada.HasValue ? "Editar materia" : "Nueva materia")</h2><button class="icon-button" @onclick="CerrarMateria" disabled="@procesando">×</button></div>
    <EditForm Model="modeloMateria" OnValidSubmit="GuardarMateria"><DataAnnotationsValidator /><ValidationSummary />
      <div class="form-grid">
        <div class="form-field"><label>Clave</label><InputText @bind-Value="modeloMateria.Clave" /></div>
        <div class="form-field"><label>Nombre</label><InputText @bind-Value="modeloMateria.Nombre" /></div>
        <div class="form-field"><label>Semestre</label><InputNumber @bind-Value="modeloMateria.Semestre" min="1" max="9" /></div>
        <div class="form-field"><label>Créditos</label><InputNumber @bind-Value="modeloMateria.Creditos" min="0" max="30" /></div>
        <div class="form-field"><label>Horas teóricas</label><InputNumber @bind-Value="modeloMateria.HorasTeoricas" min="0" max="20" /></div>
        <div class="form-field"><label>Horas prácticas</label><InputNumber @bind-Value="modeloMateria.HorasPracticas" min="0" max="20" /></div>
        <div class="form-field full"><label>Modalidades</label>
          <div class="modality-options">
            @foreach (var mod in modalidades)
            {
              <label class="modality-option">
                <input type="checkbox"
                       checked="@modeloMateria.ModalidadIds.Contains(mod.Id)"
                       @onchange="e => AlternarModalidad(mod.Id, e.Value as bool? == true)" />
                <span>@mod.Nombre</span>
              </label>
            }
          </div>
        </div>
      </div>
      <div class="modal-actions"><button type="button" class="btn-ghost" @onclick="CerrarMateria" disabled="@procesando">Cancelar</button><button class="btn-primary" disabled="@procesando">@(procesando ? "Guardando…" : "Guardar materia")</button></div>
    </EditForm>
  </section></div>
}

@if (Ocupado)
{
  <div class="loading-overlay" role="status" aria-live="polite">
    <div class="loading-card"><span class="loading-spinner"></span><strong>@TextoCarga</strong><small>Por favor espera.</small></div>
  </div>
}

@code {
  private List<CarreraDto> carreras=[]; private List<ReticulaDto> reticulas=[]; private List<MateriaDto> materias=[]; private List<ModalidadPlanDto> modalidades=[];
  private Guid carreraId, reticulaId; private int semestre; private bool esAdministrador, cargaInicial=true, cargandoReticulas, cargandoMaterias, procesando, mostrarMateria; private Guid? materiaEditada; private string filtro="", error="", mensaje="";
  private GuardarMateriaRequest modeloMateria=new();
  private bool Ocupado => cargaInicial || cargandoReticulas || cargandoMaterias || procesando;
  private string TextoCarga => procesando ? "Guardando cambios…" : cargandoMaterias ? "Cargando materias…" : cargandoReticulas ? "Cargando retículas…" : "Cargando catálogos…";
  private IEnumerable<MateriaDto> MateriasFiltradas => materias.Where(x=>(semestre==0||x.Semestre==semestre)&&(string.IsNullOrWhiteSpace(filtro)||x.Clave.Contains(filtro,StringComparison.OrdinalIgnoreCase)||x.Nombre.Contains(filtro,StringComparison.OrdinalIgnoreCase)));

  protected override async Task OnInitializedAsync()
  {
    try
    {
      var auth=await AuthenticationStateProvider.GetAuthenticationStateAsync();
      esAdministrador=auth.User.IsInRole("Administrador");
      var carrerasTask=CarrerasApi.ListarAsync();
      var modalidadesTask=Api.ModalidadesAsync();
      await Task.WhenAll(carrerasTask,modalidadesTask);
      carreras=(await carrerasTask).ToList();
      modalidades=(await modalidadesTask).ToList();
    }
    catch(Exception ex){error=$"No fue posible cargar los catálogos. {ex.Message}";}
    finally{cargaInicial=false;}
  }

  private async Task CambiarCarrera(ChangeEventArgs e)
  {
    carreraId=Guid.TryParse(e.Value?.ToString(),out var id)?id:Guid.Empty;
    reticulaId=Guid.Empty; semestre=0; reticulas=[]; materias=[]; LimpiarMensajes();
    if(carreraId==Guid.Empty)return;
    cargandoReticulas=true;
    try{reticulas=(await Api.ReticulasAsync(carreraId)).ToList();}
    catch(Exception ex){error=$"No fue posible cargar las retículas. {ex.Message}";}
    finally{cargandoReticulas=false;}
  }

  private async Task CambiarReticula(ChangeEventArgs e)
  {
    reticulaId=Guid.TryParse(e.Value?.ToString(),out var id)?id:Guid.Empty;
    semestre=0; materias=[]; LimpiarMensajes();
    if(reticulaId==Guid.Empty)return;
    await CargarMaterias();
  }

  private async Task CargarMaterias()
  {
    cargandoMaterias=true;
    try{materias=(await Api.MateriasAsync(reticulaId)).ToList();}
    catch(Exception ex){error=$"No fue posible cargar las materias. {ex.Message}";}
    finally{cargandoMaterias=false;}
  }

  private void NuevaMateria(){LimpiarMensajes();materiaEditada=null;modeloMateria=new(){ReticulaId=reticulaId,Semestre=semestre==0?1:semestre};mostrarMateria=true;}
  private void EditarMateria(MateriaDto x){LimpiarMensajes();materiaEditada=x.Id;modeloMateria=new(){ReticulaId=x.ReticulaId,Clave=x.Clave,Nombre=x.Nombre,Semestre=x.Semestre,Creditos=x.Creditos,HorasTeoricas=x.HorasTeoricas,HorasPracticas=x.HorasPracticas,ModalidadIds=x.Modalidades.Select(m=>m.Id).ToList(),RowVersion=x.RowVersion};mostrarMateria=true;}
  private void CerrarMateria(){if(!procesando)mostrarMateria=false;}
  private void AlternarModalidad(Guid id,bool activa){if(activa&&!modeloMateria.ModalidadIds.Contains(id))modeloMateria.ModalidadIds.Add(id);else if(!activa)modeloMateria.ModalidadIds.Remove(id);}
  private async Task GuardarMateria(){procesando=true;LimpiarMensajes();try{var r=await Api.GuardarMateriaAsync(materiaEditada,modeloMateria);if(!r.Correcto){error=r.Mensaje??"No fue posible guardar la materia.";return;}mostrarMateria=false;mensaje="Materia guardada correctamente.";await CargarMaterias();}catch(Exception ex){error=$"No fue posible guardar la materia. {ex.Message}";}finally{procesando=false;}}
  private async Task CambiarEstadoMateria(MateriaDto x){procesando=true;LimpiarMensajes();try{var r=await Api.EstadoMateriaAsync(x);if(!r.Correcto){error=r.Mensaje??"No fue posible cambiar el estado.";return;}mensaje=$"Materia {(x.Activo?"desactivada":"activada")} correctamente.";await CargarMaterias();}catch(Exception ex){error=$"No fue posible cambiar el estado. {ex.Message}";}finally{procesando=false;}}
  private void LimpiarMensajes(){error="";mensaje="";}
}
