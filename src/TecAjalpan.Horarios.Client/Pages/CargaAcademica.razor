@page "/carga-academica"
@attribute [Authorize(Roles = "Administrador,Jefatura,Subdirección Académica")]
@inject CargaAcademicaApi Api
@inject AuthenticationStateProvider AuthenticationStateProvider

<PageTitle>Carga académica | Horarios Tec Ajalpan</PageTitle>

<div class="page-heading">
  <div>
    <span class="eyebrow">Planeación docente</span>
    <h1>Carga académica</h1>
    <p>Asigna un docente titular a cada materia y grupo antes de generar los horarios.</p>
  </div>
  @if (configuracion is not null)
  {
    <div class="carga-resumen">
      <strong>@HorasAsignadas / @TotalHorasSemanales h semanales simultáneas</strong>
      <small>@MateriasAsignadas / @TotalMaterias materias con docente titular</small>
    </div>
  }
</div>

@if (!string.IsNullOrWhiteSpace(mensaje))
{
  <div class="alerta-exito">@mensaje</div>
}
@if (!string.IsNullOrWhiteSpace(error))
{
  <div class="alerta-error">@error</div>
}

<article class="panel carga-filtros">
  <div class="form-field">
    <label for="carga-periodo">Periodo</label>
    <InputSelect id="carga-periodo" @bind-Value="periodoId"
                 @bind-Value:after="SeleccionCambio">
      <option value="@Guid.Empty">Selecciona un periodo</option>
      @foreach (var periodo in catalogos.Periodos)
      {
        <option value="@periodo.Id">@periodo.Nombre</option>
      }
    </InputSelect>
  </div>
  <div class="form-field">
    <label for="carga-carrera">Carrera</label>
    <InputSelect id="carga-carrera" @bind-Value="carreraId"
                 @bind-Value:after="SeleccionCambio">
      <option value="@Guid.Empty">Selecciona una carrera</option>
      @foreach (var carrera in catalogos.Carreras)
      {
        <option value="@carrera.Id">@carrera.Clave · @carrera.Nombre</option>
      }
    </InputSelect>
  </div>
  <div class="form-field">
    <label for="carga-modalidad">Modalidad</label>
    <InputSelect id="carga-modalidad" @bind-Value="modalidadId"
                 @bind-Value:after="SeleccionCambio">
      <option value="@Guid.Empty">Selecciona una modalidad</option>
      @foreach (var modalidad in catalogos.Modalidades)
      {
        <option value="@modalidad.Id">@modalidad.Nombre</option>
      }
    </InputSelect>
  </div>
</article>

@if (cargando)
{
  <div class="table-state">Cargando carga académica…</div>
}
else if (!SeleccionCompleta)
{
  <div class="empty-state">
    <div class="empty-icon">▤</div>
    <h2>Selecciona periodo, carrera y modalidad</h2>
    <p>Se mostrarán los grupos y materias registrados en Oferta académica.</p>
  </div>
}
else if (configuracion is null)
{
  <div class="empty-state">
    <div class="empty-icon">＋</div>
    <h2>No existe una oferta para esta selección</h2>
    <p>Primero habilita la carrera, modalidad, grupos y materias en Oferta académica.</p>
  </div>
}
else if (configuracion.Grupos.Count == 0)
{
  <div class="empty-state compact">
    <h2>La oferta todavía no tiene grupos</h2>
    <p>Agrega grupos desde Oferta académica para comenzar la asignación docente.</p>
  </div>
}
else
{
  @if (configuracion.ResumenDocentes.Count > 0)
  {
    <section class="panel carga-docentes-panel">
      <div class="panel-title">
        <div>
          <span>Carga acumulada</span>
          <h2>Docentes del periodo</h2>
        </div>
        <small>En sabatino se muestra la carga máxima simultánea de un módulo, no la suma de los tres.</small>
      </div>
      <div class="carga-docentes-grid">
        @foreach (var docente in configuracion.ResumenDocentes)
        {
          var limite = docente.TipoDocente == 2
            ? docente.HorasDisponiblesModalidad
            : docente.CargaMaximaSemanal;
          var horasParaBarra = docente.TipoDocente == 2
            ? docente.HorasAsignadasModalidad
            : docente.HorasAsignadas;
          var porcentaje = limite == 0
            ? 0
            : Math.Min(100, horasParaBarra * 100 / limite);
          <article class="carga-docente-card">
            <div>
              <strong>@docente.DocenteNombre</strong>
              @if (docente.TipoDocente == 2)
              {
                <small>
                  @docente.HorasAsignadas h asignadas en el periodo ·
                  @docente.HorasDisponiblesModalidad bloques disponibles en @configuracion.ModalidadNombre
                  @if (docente.CargaSabatinaModulos.Count > 0)
                  {
                    <text> · @string.Join(" · ", docente.CargaSabatinaModulos.Select(x => $"M{x.Modulo} ({x.FechaInicio:dd/MM}–{x.FechaFin:dd/MM}): {x.HorasAsignadas} h"))</text>
                  }
                </small>
              }
              else
              {
                <small>
                  @docente.HorasAsignadas h frente a grupo ·
                  @docente.HorasDisponiblesModalidad bloques utilizables en @configuracion.ModalidadNombre ·
                  jornada institucional de @docente.CargaMaximaSemanal h
                </small>
              }
            </div>
            <div class="carga-barra">
              <span style="@($"width: {porcentaje}%")"></span>
            </div>
          </article>
        }
      </div>
    </section>
  }

  <div class="carga-grupos">
    @foreach (var grupo in configuracion.Grupos)
    {
      <section class="panel carga-grupo">
        <div class="carga-grupo-header">
          <div>
            <span class="eyebrow">Semestre @grupo.Semestre</span>
            <h2>@grupo.Clave · @grupo.Nombre</h2>
            <small>@(grupo.EspacioBase ?? "Sin aula o laboratorio asignado")</small>
          </div>
          <span class="record-count">@grupo.Materias.Count materia(s)</span>
        </div>

        @if (grupo.Materias.Count == 0)
        {
          <div class="empty-state compact">
            <p>Este grupo todavía no tiene materias ofertadas.</p>
          </div>
        }
        else
        {
          <div class="table-responsive">
            <table class="data-table carga-table">
              <thead>
                <tr>
                  <th>Materia</th>
                  <th>Horas</th>
                  <th>Docente titular</th>
                  <th>Estado</th>
                  <th class="actions-column">Acciones</th>
                </tr>
              </thead>
              <tbody>
                @foreach (var materia in grupo.Materias)
                {
                  <tr>
                    <td>
                      <strong>@materia.Clave · @materia.Nombre</strong>
                      <small class="table-secondary">
                        @materia.HorasTeoricas h teoría · @materia.HorasPracticas h prácticas
                      </small>
                      @if (materia.ModuloSabatino.HasValue)
                      {
                        <small class="table-secondary">
                          Módulo @materia.ModuloSabatino · @materia.SemanasModulo semanas ·
                          @materia.HorarioSabatino · @TextoFechasModulo(materia)
                        </small>
                      }
                      else if (EsSeleccionSabatina)
                      {
                        <small class="grupo-sin-espacio">Sin módulo sabatino configurado</small>
                      }
                    </td>
                    <td>
                      <strong>@materia.HorasCargaSemanal h</strong>
                      @if (materia.SemanasModulo.HasValue)
                      {
                        <small class="table-secondary">
                          por sábado · @(materia.HorasCargaSemanal * materia.SemanasModulo.Value) h totales
                        </small>
                      }
                    </td>
                    <td>
                      @if (materia.Titular is null)
                      {
                        <span class="carga-pendiente">Sin docente</span>
                      }
                      else
                      {
                        <div class="carga-asignaciones">
                          <strong>@materia.Titular.DocenteNombre</strong>
                          @if (!string.IsNullOrWhiteSpace(materia.Titular.Observaciones))
                          {
                            <small>@materia.Titular.Observaciones</small>
                          }
                        </div>
                      }
                    </td>
                    <td>
                      <span class="status @(materia.Autorizada
                        ? "status-active"
                        : materia.Titular is not null ? "status-draft" : "status-closed")">
                        @(materia.Autorizada
                          ? "Autorizada"
                          : materia.Titular is not null ? "Borrador" : "Pendiente")
                      </span>
                    </td>
                    <td class="actions-column catalogo-actions">
                      @if (puedeEditar && (!EsSeleccionSabatina || materia.ModuloSabatino.HasValue))
                      {
                        <button class="btn-link" disabled="@procesando"
                                @onclick="() => Editar(materia)">
                          @(materia.Titular is null ? "Asignar" : "Editar")
                        </button>
                        @if (materia.Titular is not null && !materia.Autorizada)
                        {
                          <button class="btn-link" disabled="@procesando"
                                  @onclick="() => ConfirmarQuitarTitular(materia)">
                            Quitar
                          </button>
                        }
                      }
                      @if (puedeAutorizar && materia.Titular is not null && !materia.Autorizada
                        && (!EsSeleccionSabatina || materia.ModuloSabatino.HasValue))
                      {
                        <button class="btn-link" disabled="@procesando"
                                @onclick="() => Autorizar(materia)">
                          Autorizar
                        </button>
                      }
                    </td>
                  </tr>
                }
              </tbody>
            </table>
          </div>
        }
      </section>
    }
  </div>
}

@if (mostrarFormulario && materiaActual is not null && puedeEditar)
{
  <div class="modal-backdrop" @onclick="CerrarFormulario">
    <section class="modal-card" role="dialog" aria-modal="true"
             aria-labelledby="titulo-carga" @onclick:stopPropagation>
      <div class="modal-header">
        <div>
          <span class="eyebrow">
            @materiaActual.Clave · @materiaActual.HorasCargaSemanal h semanales
            @if (materiaActual.ModuloSabatino.HasValue)
            {
              <text> · Módulo @materiaActual.ModuloSabatino · @materiaActual.HorarioSabatino</text>
            }
          </span>
          <h2 id="titulo-carga">@materiaActual.Nombre</h2>
        </div>
        <button class="icon-button" type="button" disabled="@procesando"
                @onclick="CerrarFormulario">×</button>
      </div>

      <EditForm Model="modelo" OnValidSubmit="Guardar">
        <DataAnnotationsValidator />
        <div class="form-grid">
          <div class="form-field full">
            <label>Docente titular</label>
            <InputSelect @bind-Value="modelo.DocenteId">
              <option value="@Guid.Empty">Selecciona un docente</option>
              @foreach (var docente in DocentesElegibles)
              {
                <option value="@docente.DocenteId">@TextoCargaDocente(docente)</option>
              }
            </InputSelect>
            @if (!DocentesElegibles.Any())
            {
              <small class="form-help">
                No hay docentes de esta carrera con disponibilidad validada y horas suficientes
                para atender esta materia en la modalidad seleccionada.
              </small>
            }
            <small>
              El titular atenderá @materiaActual.HorasCargaSemanal horas por semana
              @(materiaActual.SemanasModulo.HasValue
                ? $"durante {materiaActual.SemanasModulo} sábados"
                : "durante el periodo").
            </small>
          </div>
          <div class="form-field full">
            <label>Observaciones</label>
            <InputTextArea @bind-Value="modelo.Observaciones"
                           placeholder="Indicaciones para la asignación (opcional)" />
            <ValidationMessage For="() => modelo.Observaciones" />
          </div>
        </div>

        @if (!string.IsNullOrWhiteSpace(errorFormulario))
        {
          <div class="alerta-error modal-alert">@errorFormulario</div>
        }

        <div class="modal-actions">
          <button class="btn-ghost" type="button" disabled="@procesando"
                  @onclick="CerrarFormulario">Cancelar</button>
          <button class="btn-primary" type="submit" disabled="@procesando">
            @(procesando ? "Guardando…" : "Guardar titular")
          </button>
        </div>
      </EditForm>
    </section>
  </div>
}

@if (materiaParaQuitar?.Titular is not null && puedeEditar)
{
  <div class="modal-backdrop" @onclick="CerrarConfirmacionQuitar">
    <section class="modal-card confirm-card" role="alertdialog" aria-modal="true"
             aria-labelledby="titulo-quitar-titular" @onclick:stopPropagation>
      <div class="modal-header">
        <div>
          <span class="eyebrow">Confirmar corrección</span>
          <h2 id="titulo-quitar-titular">Quitar docente titular</h2>
        </div>
        <button class="icon-button" type="button" disabled="@procesando"
                @onclick="CerrarConfirmacionQuitar">×</button>
      </div>
      <p>
        Se quitará a <strong>@materiaParaQuitar.Titular.DocenteNombre</strong> de
        <strong>@materiaParaQuitar.Clave · @materiaParaQuitar.Nombre</strong>.
        La materia volverá a quedar pendiente y podrás asignar otro docente después.
      </p>
      @if (!string.IsNullOrWhiteSpace(errorQuitar))
      {
        <div class="alerta-error modal-alert">@errorQuitar</div>
      }
      <div class="modal-actions">
        <button class="btn-ghost" type="button" disabled="@procesando"
                @onclick="CerrarConfirmacionQuitar">Cancelar</button>
        <button class="btn-danger" type="button" disabled="@procesando"
                @onclick="QuitarTitular">
          @(procesando ? "Quitando…" : "Sí, quitar titular")
        </button>
      </div>
    </section>
  </div>
}

@if (procesando)
{
  <div class="loading-overlay" role="status" aria-live="polite"
       aria-busy="true">
    <div class="loading-card">
      <span class="loading-spinner"></span>
      <strong>Procesando carga académica…</strong>
      <small>Por favor espera.</small>
    </div>
  </div>
}

@code {
  private CargaAcademicaCatalogosDto catalogos = new([], [], []);
  private CargaConfiguracionDto? configuracion;
  private CargaMateriaDto? materiaActual;
  private CargaMateriaDto? materiaParaQuitar;
  private GuardarCargaAcademicaRequest modelo = new();
  private Guid periodoId;
  private Guid carreraId;
  private Guid modalidadId;
  private bool cargando = true;
  private bool procesando;
  private bool mostrarFormulario;
  private bool puedeEditar;
  private bool puedeAutorizar;
  private string? mensaje;
  private string? error;
  private string? errorFormulario;
  private string? errorQuitar;

  private bool SeleccionCompleta => periodoId != Guid.Empty
    && carreraId != Guid.Empty
    && modalidadId != Guid.Empty;
  private bool EsSeleccionSabatina =>
    catalogos.Modalidades.FirstOrDefault(x => x.Id == modalidadId)?.Clave == "SAB";
  private IEnumerable<CargaDocenteResumenDto> DocentesCarrera =>
    configuracion?.ResumenDocentes.OrderBy(x => x.DocenteNombre)
      ?? Enumerable.Empty<CargaDocenteResumenDto>();
  private IEnumerable<CargaDocenteResumenDto> DocentesElegibles =>
    materiaActual is null
      ? DocentesCarrera
      : DocentesCarrera.Where(x => PuedeAtenderMateria(x, materiaActual));
  private int TotalMaterias =>
    configuracion?.Grupos.Sum(x => x.Materias.Count) ?? 0;
  private int MateriasAsignadas =>
    configuracion?.Grupos.Sum(x => x.Materias.Count(m => m.Titular is not null)) ?? 0;
  private int TotalHorasSemanales =>
    EsSeleccionSabatina
      ? configuracion?.Grupos.Sum(x => x.Materias
          .GroupBy(m => m.ModuloSabatino)
          .Select(g => g.Sum(m => (int)m.HorasCargaSemanal))
          .DefaultIfEmpty(0).Max()) ?? 0
      : configuracion?.Grupos.Sum(x => x.Materias.Sum(m => (int)m.HorasCargaSemanal)) ?? 0;
  private int HorasAsignadas =>
    EsSeleccionSabatina
      ? configuracion?.Grupos.Sum(x => x.Materias
          .Where(m => m.Titular is not null)
          .GroupBy(m => m.ModuloSabatino)
          .Select(g => g.Sum(m => (int)m.HorasCargaSemanal))
          .DefaultIfEmpty(0).Max()) ?? 0
      : configuracion?.Grupos.Sum(x => x.Materias
          .Where(m => m.Titular is not null)
          .Sum(m => (int)m.HorasCargaSemanal)) ?? 0;

  protected override async Task OnInitializedAsync()
  {
    var estado = await AuthenticationStateProvider.GetAuthenticationStateAsync();
    puedeEditar = estado.User.IsInRole("Administrador")
      || estado.User.IsInRole("Jefatura");
    puedeAutorizar = estado.User.IsInRole("Administrador")
      || estado.User.IsInRole("Subdirección Académica");

    try
    {
      catalogos = await Api.ObtenerCatalogosAsync();
      periodoId = catalogos.Periodos.FirstOrDefault(x => x.Estado == 2)?.Id
        ?? catalogos.Periodos.FirstOrDefault()?.Id
        ?? Guid.Empty;
      carreraId = catalogos.Carreras.Count == 1
        ? catalogos.Carreras[0].Id
        : Guid.Empty;
      modalidadId = catalogos.Modalidades.Count == 1
        ? catalogos.Modalidades[0].Id
        : Guid.Empty;
      await Cargar();
    }
    catch (Exception ex)
    {
      error = $"No fue posible cargar los catálogos: {ex.Message}";
    }
    finally
    {
      cargando = false;
    }
  }

  private Task SeleccionCambio() => Cargar();

  private async Task Cargar()
  {
    error = null;
    mensaje = null;
    configuracion = null;
    if (!SeleccionCompleta)
      return;

    cargando = true;
    try
    {
      var resultado = await Api.ObtenerAsync(periodoId, carreraId, modalidadId);
      if (!resultado.Correcto)
      {
        error = resultado.Mensaje;
        return;
      }
      configuracion = resultado.Valor;
    }
    catch (Exception ex)
    {
      error = $"No fue posible cargar la carga académica: {ex.Message}";
    }
    finally
    {
      cargando = false;
    }
  }

  private static string TextoCargaDocente(CargaDocenteResumenDto docente)
  {
    if (docente.TipoDocente == 2)
    {
      return $"{docente.DocenteNombre} · {docente.HorasAsignadasModalidad} h máximas por módulo · {docente.HorasDisponiblesModalidad} bloques disponibles";
    }

    return $"{docente.DocenteNombre} · {docente.HorasAsignadasModalidad} h asignadas en modalidad · {docente.HorasDisponiblesModalidad} bloques utilizables · {docente.HorasAsignadas} h frente a grupo totales";
  }

  private static string TextoFechasModulo(CargaMateriaDto materia) =>
    materia.FechaInicioModulo.HasValue && materia.FechaFinModulo.HasValue
      ? $"{materia.FechaInicioModulo.Value:dd/MM/yyyy}–{materia.FechaFinModulo.Value:dd/MM/yyyy}"
      : string.Empty;

  private static bool PuedeAtenderMateria(
    CargaDocenteResumenDto docente,
    CargaMateriaDto materia)
  {
    if (materia.TurnoSabatino == 1 && !docente.DisponibleMatutinoSabatino)
      return false;
    if (materia.TurnoSabatino == 2 && !docente.DisponibleVespertinoSabatino)
      return false;

    var horasActuales = materia.Titular?.DocenteId == docente.DocenteId
      ? materia.HorasCargaSemanal
      : 0;
    var cargasCoincidentes = materia.FechaInicioModulo.HasValue && materia.FechaFinModulo.HasValue
      ? docente.CargaSabatinaModulos.Where(x => SeTraslapan(
          x.FechaInicio, x.FechaFin,
          materia.FechaInicioModulo.Value, materia.FechaFinModulo.Value)).ToArray()
      : [];
    if (horasActuales == 0
      && ((materia.TurnoSabatino == 1 && cargasCoincidentes.Any(x => x.OcupaMatutino))
        || (materia.TurnoSabatino == 2 && cargasCoincidentes.Any(x => x.OcupaVespertino))))
      return false;
    var horasModulo = materia.ModuloSabatino.HasValue
      ? MaximoHorasEnIntervalo(
          cargasCoincidentes,
          materia.FechaInicioModulo!.Value,
          materia.FechaFinModulo!.Value)
      : docente.HorasAsignadasModalidad;
    var nuevaCargaModalidad = horasModulo - horasActuales + materia.HorasCargaSemanal;
    if (nuevaCargaModalidad > docente.HorasDisponiblesModalidad)
    {
      return false;
    }

    var nuevaCargaGlobal = materia.ModuloSabatino.HasValue
      ? docente.HorasEscolarizadas + MaximoSabatinoConMateria(
          docente.CargaSabatinaModulos,
          materia.FechaInicioModulo!.Value,
          materia.FechaFinModulo!.Value,
          horasActuales)
      : docente.HorasAsignadas - horasActuales + materia.HorasCargaSemanal;
    return docente.TipoDocente != 1
      || nuevaCargaGlobal <= docente.CargaMaximaSemanal;
  }

  private static int MaximoHorasEnIntervalo(
    CargaDocenteModuloDto[] cargas,
    DateOnly inicio,
    DateOnly fin)
  {
    var maximo = 0;
    for (var fecha = inicio; fecha <= fin; fecha = fecha.AddDays(7))
    {
      maximo = Math.Max(maximo, cargas
        .Where(x => x.FechaInicio <= fecha && x.FechaFin >= fecha)
        .Sum(x => x.HorasAsignadas));
    }
    return maximo;
  }

  private static int MaximoSabatinoConMateria(
    IReadOnlyList<CargaDocenteModuloDto> cargas,
    DateOnly inicioMateria,
    DateOnly finMateria,
    int horasActuales)
  {
    var inicio = cargas.Select(x => x.FechaInicio).Append(inicioMateria).Min();
    var fin = cargas.Select(x => x.FechaFin).Append(finMateria).Max();
    var maximo = 0;
    for (var fecha = inicio; fecha <= fin; fecha = fecha.AddDays(7))
    {
      var horas = cargas
        .Where(x => x.FechaInicio <= fecha && x.FechaFin >= fecha)
        .Sum(x => x.HorasAsignadas);
      if (fecha >= inicioMateria && fecha <= finMateria)
        horas = horas - horasActuales + 4;
      maximo = Math.Max(maximo, horas);
    }
    return maximo;
  }

  private static bool SeTraslapan(
    DateOnly inicioA, DateOnly finA, DateOnly inicioB, DateOnly finB) =>
    inicioA <= finB && inicioB <= finA;

  private void Editar(CargaMateriaDto materia)
  {
    materiaActual = materia;
    modelo = new GuardarCargaAcademicaRequest
    {
      OfertaMateriaId = materia.OfertaMateriaId,
      DocenteId = materia.Titular?.DocenteId ?? Guid.Empty,
      Observaciones = materia.Titular?.Observaciones,
      RowVersion = materia.Titular?.RowVersion
    };
    errorFormulario = null;
    mostrarFormulario = true;
  }

  private async Task Guardar()
  {
    if (materiaActual is null)
      return;
    if (modelo.DocenteId == Guid.Empty)
    {
      errorFormulario = "Selecciona al docente titular.";
      return;
    }

    procesando = true;
    errorFormulario = null;
    try
    {
      var resultado = await Api.GuardarAsync(modelo);
      if (!resultado.Correcto || resultado.Valor is null)
      {
        errorFormulario = resultado.Mensaje;
        return;
      }

      mostrarFormulario = false;
      materiaActual = null;
      await Cargar();
      mensaje = "Docente titular guardado correctamente.";
    }
    catch (Exception ex)
    {
      errorFormulario = $"No fue posible guardar la carga: {ex.Message}";
    }
    finally
    {
      procesando = false;
    }
  }

  private async Task Autorizar(CargaMateriaDto materia)
  {
    if (materia.Titular is null)
      return;

    procesando = true;
    error = null;
    try
    {
      var request = new AutorizarCargaAcademicaRequest
      {
        CargaAcademicaId = materia.Titular.Id,
        RowVersion = materia.Titular.RowVersion
      };
      var resultado = await Api.AutorizarAsync(
        materia.OfertaMateriaId, request);
      if (!resultado.Correcto || resultado.Valor is null)
      {
        error = resultado.Mensaje;
        return;
      }

      ReemplazarMateria(resultado.Valor);
      mensaje = "Carga académica autorizada correctamente.";
    }
    catch (Exception ex)
    {
      error = $"No fue posible autorizar la carga: {ex.Message}";
    }
    finally
    {
      procesando = false;
    }
  }

  private void ConfirmarQuitarTitular(CargaMateriaDto materia)
  {
    if (materia.Titular is null || materia.Autorizada)
      return;

    materiaParaQuitar = materia;
    errorQuitar = null;
  }

  private async Task QuitarTitular()
  {
    if (materiaParaQuitar?.Titular is null)
      return;

    procesando = true;
    errorQuitar = null;
    try
    {
      var request = new QuitarTitularCargaAcademicaRequest
      {
        CargaAcademicaId = materiaParaQuitar.Titular.Id,
        RowVersion = materiaParaQuitar.Titular.RowVersion
      };
      var resultado = await Api.QuitarTitularAsync(
        materiaParaQuitar.OfertaMateriaId, request);
      if (!resultado.Correcto || resultado.Valor is null)
      {
        errorQuitar = resultado.Mensaje;
        return;
      }

      materiaParaQuitar = null;
      await Cargar();
      mensaje = "Docente titular quitado. La materia volvió a quedar pendiente.";
    }
    catch (Exception ex)
    {
      errorQuitar = $"No fue posible quitar al docente titular: {ex.Message}";
    }
    finally
    {
      procesando = false;
    }
  }

  private void ReemplazarMateria(CargaMateriaDto actualizada)
  {
    if (configuracion is null)
      return;

    configuracion = configuracion with
    {
      Grupos = configuracion.Grupos.Select(grupo => grupo with
      {
        Materias = grupo.Materias.Select(materia =>
          materia.OfertaMateriaId == actualizada.OfertaMateriaId
            ? actualizada
            : materia).ToArray()
      }).ToArray()
    };
  }

  private void CerrarFormulario()
  {
    if (procesando)
      return;
    mostrarFormulario = false;
    materiaActual = null;
    errorFormulario = null;
  }

  private void CerrarConfirmacionQuitar()
  {
    if (procesando)
      return;
    materiaParaQuitar = null;
    errorQuitar = null;
  }

}
