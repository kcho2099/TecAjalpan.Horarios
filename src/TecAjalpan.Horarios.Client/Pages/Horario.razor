@page "/horario"
@page "/horario/{VersionId:guid}"
@attribute [Authorize(Roles = "Administrador,Jefatura")]
@inject HorariosApi HorariosApi
@inject NavigationManager NavigationManager

<PageTitle>Horario generado | Horarios Tec Ajalpan</PageTitle>

<div class="page-heading horario-heading">
  <div>
    <span class="eyebrow">Revisión de propuesta</span>
    <h1>Horario generado</h1>
    <p>Consulta la propuesta como calendario semanal. Elige un grupo o un docente para revisar sus clases y detectar espacios o cruces.</p>
  </div>
  @if (detalle is not null)
  {
    <div class="horario-heading-acciones">
      <a class="btn-exportar-horario" href="@UrlExportarExcel" download>
        <span aria-hidden="true">⇩</span> Exportar Excel
      </a>
      <span class="status @(detalle.Pendientes.Count == 0 ? "status-active" : "status-draft")">
        Versión @detalle.Numero · @detalle.EstadoTexto
      </span>
      @if (detalle.Estado == 1)
      {
        <button class="btn-descartar" type="button" @onclick="ConfirmarDescarte">
          Descartar versión
        </button>
      }
    </div>
  }
</div>

@if (!string.IsNullOrWhiteSpace(error))
{
  <div class="alerta-error">@error</div>
}

<article class="panel horario-filtros">
  <div class="horario-filtros-principales">
    <div class="form-field horario-filtro-periodo">
      <label for="horario-periodo">Periodo</label>
      <InputSelect id="horario-periodo" @bind-Value="periodoId" @bind-Value:after="OnPeriodoChanged">
        <option value="@Guid.Empty">Selecciona un periodo</option>
        @foreach (var periodo in periodos)
        {
          <option value="@periodo.Id">@periodo.Nombre</option>
        }
      </InputSelect>
    </div>
    <div class="form-field horario-filtro-version">
      <label for="horario-version">Versión</label>
      <InputSelect id="horario-version" @bind-Value="versionIdSeleccionada" @bind-Value:after="OnVersionChanged">
        <option value="@Guid.Empty">Sin versiones</option>
        @foreach (var version in versiones)
        {
          <option value="@version.Id">Versión @version.Numero · @version.EstadoTexto</option>
        }
      </InputSelect>
    </div>
  </div>

  <div class="horario-filtros-vista">
    <div class="form-field">
      <label for="horario-carrera">Carrera</label>
      <select id="horario-carrera" @bind="carreraId" @bind:after="OnCarreraChanged">
        <option value="@Guid.Empty">Todas</option>
        @foreach (var carrera in Carreras)
        {
          <option value="@carrera.Id">@carrera.Nombre</option>
        }
      </select>
    </div>
    <div class="form-field">
      <label for="horario-modalidad">Modalidad</label>
      <select id="horario-modalidad" @bind="modalidadId" @bind:after="OnModalidadChanged">
        <option value="@Guid.Empty">Todas</option>
        @foreach (var modalidad in Modalidades)
        {
          <option value="@modalidad.Id">@modalidad.Nombre</option>
        }
      </select>
    </div>
    <div class="form-field horario-filtro-enfoque">
      <label for="horario-grupo">Ver horario del grupo</label>
      <select id="horario-grupo" @bind="grupoId" @bind:after="OnGrupoChanged">
        <option value="@Guid.Empty">Selecciona un grupo</option>
        @foreach (var grupo in Grupos)
        {
          <option value="@grupo.Id">@grupo.Nombre</option>
        }
      </select>
    </div>
    <div class="horario-separador-filtro"><span>o</span></div>
    <div class="form-field horario-filtro-enfoque">
      <label for="horario-docente">Ver horario del docente</label>
      <select id="horario-docente" @bind="docenteId" @bind:after="OnDocenteChanged">
        <option value="@Guid.Empty">Selecciona un docente</option>
        @foreach (var docente in Docentes)
        {
          <option value="@docente.Id">@docente.Nombre</option>
        }
      </select>
    </div>
  </div>
</article>

@if (cargando)
{
  <article class="panel table-state">Cargando horario guardado…</article>
}
else if (detalle is null)
{
  <article class="panel empty-state compact">
    <div class="empty-icon">⌁</div>
    <h2>Sin versiones guardadas</h2>
    <p>Genera una propuesta para este periodo y aquí podrás revisarla.</p>
  </article>
}
else if (grupoId == Guid.Empty && docenteId == Guid.Empty)
{
  <article class="panel empty-state compact">
    <div class="empty-icon">▦</div>
    <h2>Selecciona qué horario quieres revisar</h2>
    <p>Elige un grupo o un docente en los filtros para abrir su calendario semanal.</p>
  </article>
}
else
{
  <section class="horario-contexto">
    <div>
      <span class="eyebrow">Vista semanal</span>
      <h2>@TituloVista</h2>
      <p>@SubtituloVista</p>
    </div>
    <div class="horario-indicadores">
      <span><strong>@MateriasVisibles</strong> materias</span>
      <span><strong>@HorasVisibles</strong> bloques visibles</span>
      <span><strong>@SesionesFechadas</strong> sesiones fechadas</span>
    </div>
  </section>

  @if (BloquesVisuales.Count == 0)
  {
    <article class="panel empty-state compact">
      <div class="empty-icon">⌁</div>
      <h2>Sin clases con estos filtros</h2>
      <p>Cambia la carrera, modalidad, grupo o docente para consultar otra distribución.</p>
    </article>
  }
  else
  {
    <article class="panel horario-calendario-panel">
      <div class="horario-leyenda">
        <span><i class="horario-leyenda-color"></i> Cada tarjeta representa una materia</span>
        <span>Las fechas indican su vigencia real dentro del periodo</span>
      </div>
      <div class="horario-calendario-scroll">
        <div class="horario-calendario">
          <div class="horario-esquina">Hora</div>
          @foreach (var dia in Dias)
          {
            <div class="horario-dia" style="grid-column:@(dia.Id + 1);grid-row:1">@dia.Nombre</div>
          }

          @for (var bloque = 1; bloque <= 8; bloque++)
          {
            <div class="horario-hora" style="grid-column:1;grid-row:@(bloque + 1)">
              <strong>@HoraInicio(bloque)</strong>
              <small>@HoraInicio(bloque + 1)</small>
            </div>
            @for (var dia = 1; dia <= 6; dia++)
            {
              <div class="horario-celda" style="grid-column:@(dia + 1);grid-row:@(bloque + 1)"></div>
            }
          }

          @foreach (var bloque in BloquesVisuales)
          {
            <div class="horario-bloque" style="@EstiloBloque(bloque)">
              <div class="horario-bloque-hora">@HoraInicio(bloque.BloqueInicio)–@HoraInicio(bloque.BloqueInicio + bloque.Duracion)</div>
              @foreach (var evento in bloque.Eventos)
              {
                <div class="horario-evento @ClaseColor(evento.MateriaClave)">
                  <strong>@evento.Materia</strong>
                  <span>@evento.MateriaClave</span>
                  @if (docenteId == Guid.Empty)
                  {
                    <span class="horario-evento-dato">@evento.Docente</span>
                  }
                  else
                  {
                    <span class="horario-evento-dato">Grupo @evento.Grupo · @evento.Carrera · @evento.Modalidad</span>
                  }
                  <span class="horario-evento-dato">@evento.Espacio</span>
                  <small>@evento.FechaInicio.ToString("dd/MM/yyyy")–@evento.FechaFin.ToString("dd/MM/yyyy")</small>
                </div>
              }
            </div>
          }
        </div>
      </div>
    </article>
  }
}

@if (mostrarConfirmacionDescartar && detalle is not null)
{
  <div class="modal-backdrop" @onclick="CerrarConfirmacionDescarte">
    <section class="modal-card confirm-card" role="alertdialog" aria-modal="true"
             aria-labelledby="titulo-descartar-version" @onclick:stopPropagation>
      <div class="modal-header">
        <div>
          <span class="eyebrow">Confirmar descarte</span>
          <h2 id="titulo-descartar-version">Descartar versión @detalle.Numero</h2>
        </div>
        <button class="icon-button" type="button" disabled="@descartando"
                @onclick="CerrarConfirmacionDescarte">×</button>
      </div>
      <p>La propuesta dejará de aparecer en el generador y no podrá aprobarse ni publicarse.</p>
      <p class="modal-help">Se conservará como registro histórico en la auditoría.</p>
      @if (!string.IsNullOrWhiteSpace(error))
      {
        <div class="alerta-error">@error</div>
      }
      <div class="modal-actions">
        <button class="btn-ghost" type="button" disabled="@descartando"
                @onclick="CerrarConfirmacionDescarte">Cancelar</button>
        <button class="btn-danger" type="button" disabled="@descartando" @onclick="DescartarVersion">
          @(descartando ? "Descartando…" : "Sí, descartar versión")
        </button>
      </div>
    </section>
  </div>
}

@if (Ocupado)
{
  <div class="loading-overlay" role="status" aria-live="polite" aria-busy="true">
    <div class="loading-card horario-loading-card">
      <span class="loading-spinner"></span>
      <strong>@TextoCarga</strong>
      <small>@DetalleCarga</small>
    </div>
  </div>
}

@code {
  [Parameter] public Guid? VersionId { get; set; }

  private static readonly OpcionDia[] Dias =
  [
    new(1, "Lunes"), new(2, "Martes"), new(3, "Miércoles"),
    new(4, "Jueves"), new(5, "Viernes"), new(6, "Sábado")
  ];

  private List<PeriodoGeneracionDto> periodos = [];
  private List<HorarioVersionResumenDto> versiones = [];
  private HorarioDetalleDto? detalle;
  private Guid periodoId;
  private Guid versionIdSeleccionada;
  private Guid carreraId;
  private Guid modalidadId;
  private Guid grupoId;
  private Guid docenteId;
  private bool cargando = true;
  private bool descartando;
  private bool mostrarConfirmacionDescartar;
  private string? error;

  private bool Ocupado => cargando || descartando;
  private string TextoCarga => descartando
    ? "Descartando la versión…"
    : "Preparando el horario semanal…";
  private string DetalleCarga => descartando
    ? "Actualizando las versiones disponibles."
    : "Cargando las sesiones y construyendo la cuadrícula.";
  private string UrlExportarExcel
  {
    get
    {
      if (detalle is null)
        return "#";

      var filtros = new List<string>();
      if (carreraId != Guid.Empty)
        filtros.Add($"carreraId={carreraId}");
      if (modalidadId != Guid.Empty)
        filtros.Add($"modalidadId={modalidadId}");
      if (grupoId != Guid.Empty)
        filtros.Add($"grupoId={grupoId}");
      if (docenteId != Guid.Empty)
        filtros.Add($"docenteId={docenteId}");
      var consulta = filtros.Count == 0
        ? string.Empty
        : "?" + string.Join("&", filtros);
      return $"api/horarios/versiones/{detalle.Id}/excel{consulta}";
    }
  }
  private HorarioSesionResumenDto[] SesionesFiltradas => detalle?.Sesiones
    .Where(x => carreraId == Guid.Empty || x.CarreraId == carreraId)
    .Where(x => modalidadId == Guid.Empty || x.ModalidadId == modalidadId)
    .Where(x => grupoId == Guid.Empty || x.GrupoId == grupoId)
    .Where(x => docenteId == Guid.Empty || x.DocenteId == docenteId)
    .ToArray() ?? [];

  private List<BloqueHorario> BloquesVisuales => ConstruirBloques(SesionesFiltradas);
  private int MateriasVisibles => SesionesFiltradas.Select(x => x.CargaAcademicaId).Distinct().Count();
  private int HorasVisibles => SesionesFiltradas.Length;
  private int SesionesFechadas => SesionesFiltradas.Sum(x => x.NumeroSesiones);
  private string TituloVista => docenteId != Guid.Empty
    ? Docentes.FirstOrDefault(x => x.Id == docenteId)?.Nombre ?? "Docente"
    : $"Grupo {Grupos.FirstOrDefault(x => x.Id == grupoId)?.Nombre}";
  private string SubtituloVista => docenteId != Guid.Empty
    ? "Clases del docente en todas las carreras y grupos seleccionados."
    : SesionesFiltradas.FirstOrDefault() is { } sesion
      ? $"{sesion.Carrera} · {sesion.Modalidad}"
      : "Distribución de clases del grupo seleccionado.";

  private OpcionFiltro[] Carreras => detalle?.Sesiones
    .Select(x => new OpcionFiltro(x.CarreraId, x.Carrera)).Distinct()
    .OrderBy(x => x.Nombre).ToArray() ?? [];

  private OpcionFiltro[] Modalidades => detalle?.Sesiones
    .Where(x => carreraId == Guid.Empty || x.CarreraId == carreraId)
    .Select(x => new OpcionFiltro(x.ModalidadId, x.Modalidad)).Distinct()
    .OrderBy(x => x.Nombre).ToArray() ?? [];

  private OpcionFiltro[] Grupos => detalle?.Sesiones
    .Where(x => carreraId == Guid.Empty || x.CarreraId == carreraId)
    .Where(x => modalidadId == Guid.Empty || x.ModalidadId == modalidadId)
    .Select(x => new OpcionFiltro(x.GrupoId, x.Grupo)).Distinct()
    .OrderBy(x => x.Nombre).ToArray() ?? [];

  private OpcionFiltro[] Docentes => detalle?.Sesiones
    .Where(x => carreraId == Guid.Empty || x.CarreraId == carreraId)
    .Where(x => modalidadId == Guid.Empty || x.ModalidadId == modalidadId)
    .Select(x => new OpcionFiltro(x.DocenteId, x.Docente)).Distinct()
    .OrderBy(x => x.Nombre).ToArray() ?? [];

  protected override async Task OnInitializedAsync()
  {
    try
    {
      periodos = (await HorariosApi.ListarPeriodosAsync()).ToList();
      if (VersionId.HasValue)
      {
        await CargarDetalle(VersionId.Value);
        if (detalle is not null)
        {
          periodoId = detalle.PeriodoId;
          versiones = (await HorariosApi.ListarVersionesAsync(periodoId)).ToList();
        }
      }
      else
      {
        periodoId = periodos.FirstOrDefault(x => x.Estado == 2)?.Id
          ?? periodos.FirstOrDefault()?.Id
          ?? Guid.Empty;
        await CargarVersionesYUltima();
      }

      SeleccionarPrimerGrupo();
    }
    catch (Exception ex)
    {
      error = ex.Message;
    }
    finally
    {
      cargando = false;
    }
  }

  private async Task OnPeriodoChanged()
  {
    cargando = true;
    error = null;
    await Task.Yield();
    try
    {
      LimpiarFiltros();
      await CargarVersionesYUltima();
      SeleccionarPrimerGrupo();
    }
    catch (Exception ex)
    {
      error = ex.Message;
    }
    finally
    {
      cargando = false;
    }
  }

  private async Task OnVersionChanged()
  {
    cargando = true;
    error = null;
    await Task.Yield();
    try
    {
      LimpiarFiltros();
      if (versionIdSeleccionada == Guid.Empty)
        detalle = null;
      else
        await CargarDetalle(versionIdSeleccionada);
      SeleccionarPrimerGrupo();
    }
    catch (Exception ex)
    {
      error = ex.Message;
    }
    finally
    {
      cargando = false;
    }
  }

  private Task OnCarreraChanged()
  {
    modalidadId = Guid.Empty;
    grupoId = Guid.Empty;
    docenteId = Guid.Empty;
    SeleccionarPrimerGrupo();
    return Task.CompletedTask;
  }

  private Task OnModalidadChanged()
  {
    grupoId = Guid.Empty;
    docenteId = Guid.Empty;
    SeleccionarPrimerGrupo();
    return Task.CompletedTask;
  }

  private Task OnGrupoChanged()
  {
    if (grupoId != Guid.Empty)
      docenteId = Guid.Empty;
    return Task.CompletedTask;
  }

  private Task OnDocenteChanged()
  {
    if (docenteId != Guid.Empty)
      grupoId = Guid.Empty;
    return Task.CompletedTask;
  }

  private async Task CargarVersionesYUltima()
  {
    versiones = periodoId == Guid.Empty
      ? []
      : (await HorariosApi.ListarVersionesAsync(periodoId)).ToList();
    versionIdSeleccionada = versiones.FirstOrDefault()?.Id ?? Guid.Empty;
    if (versionIdSeleccionada == Guid.Empty)
      detalle = null;
    else
      await CargarDetalle(versionIdSeleccionada);
  }

  private async Task CargarDetalle(Guid id)
  {
    detalle = await HorariosApi.ObtenerVersionAsync(id);
    versionIdSeleccionada = detalle?.Id ?? Guid.Empty;
  }

  private void SeleccionarPrimerGrupo()
  {
    if (grupoId == Guid.Empty && docenteId == Guid.Empty)
      grupoId = Grupos.FirstOrDefault()?.Id ?? Guid.Empty;
  }

  private void LimpiarFiltros()
  {
    carreraId = Guid.Empty;
    modalidadId = Guid.Empty;
    grupoId = Guid.Empty;
    docenteId = Guid.Empty;
  }

  private static List<BloqueHorario> ConstruirBloques(HorarioSesionResumenDto[] sesiones)
  {
    var eventos = new List<EventoHorario>();
    var grupos = sesiones.GroupBy(x => new
    {
      x.CargaAcademicaId, x.Dia, x.MateriaClave, x.Materia, x.DocenteId,
      x.Docente, x.GrupoId, x.Grupo, x.Carrera, x.Modalidad, x.Espacio,
      x.FechaInicio, x.FechaFin, x.NumeroSesiones
    });

    foreach (var grupo in grupos)
    {
      var bloques = grupo.Select(x => (int)x.Bloque).Distinct().OrderBy(x => x).ToArray();
      if (bloques.Length == 0)
        continue;

      var inicio = bloques[0];
      var anterior = inicio;
      foreach (var bloque in bloques.Skip(1))
      {
        if (bloque == anterior + 1)
        {
          anterior = bloque;
          continue;
        }

        eventos.Add(new EventoHorario(
          grupo.Key.Dia, inicio, anterior - inicio + 1,
          grupo.Key.MateriaClave, grupo.Key.Materia, grupo.Key.Docente,
          grupo.Key.Grupo, grupo.Key.Carrera, grupo.Key.Modalidad, grupo.Key.Espacio,
          grupo.Key.FechaInicio, grupo.Key.FechaFin));
        inicio = bloque;
        anterior = bloque;
      }

      eventos.Add(new EventoHorario(
        grupo.Key.Dia, inicio, anterior - inicio + 1,
        grupo.Key.MateriaClave, grupo.Key.Materia, grupo.Key.Docente,
        grupo.Key.Grupo, grupo.Key.Carrera, grupo.Key.Modalidad, grupo.Key.Espacio,
        grupo.Key.FechaInicio, grupo.Key.FechaFin));
    }

    return eventos
      .GroupBy(x => new { x.Dia, x.BloqueInicio, x.Duracion })
      .Select(x => new BloqueHorario(
        x.Key.Dia,
        x.Key.BloqueInicio,
        x.Key.Duracion,
        x.OrderBy(y => y.FechaInicio).ThenBy(y => y.Materia).ToArray()))
      .OrderBy(x => x.Dia)
      .ThenBy(x => x.BloqueInicio)
      .ToList();
  }

  private static string EstiloBloque(BloqueHorario bloque) =>
    $"grid-column:{bloque.Dia + 1};grid-row:{bloque.BloqueInicio + 1} / span {bloque.Duracion}";

  private static string HoraInicio(int bloque) => $"{Math.Clamp(7 + bloque, 0, 23):00}:00";

  private static string ClaseColor(string clave)
  {
    var indice = clave.Aggregate(0, (total, caracter) => total + caracter) % 6;
    return $"horario-color-{indice + 1}";
  }

  private void ConfirmarDescarte() => mostrarConfirmacionDescartar = true;

  private void CerrarConfirmacionDescarte()
  {
    if (!descartando)
      mostrarConfirmacionDescartar = false;
  }

  private async Task DescartarVersion()
  {
    if (detalle is null || descartando)
      return;

    descartando = true;
    error = null;
    try
    {
      var respuesta = await HorariosApi.DescartarAsync(detalle.Id);
      if (!respuesta.Correcto)
      {
        error = respuesta.Mensaje ?? "No fue posible descartar la versión.";
        return;
      }

      NavigationManager.NavigateTo("/generador");
    }
    catch (Exception ex)
    {
      error = ex.Message;
    }
    finally
    {
      descartando = false;
    }
  }

  private sealed record OpcionFiltro(Guid Id, string Nombre);
  private sealed record OpcionDia(byte Id, string Nombre);
  private sealed record EventoHorario(
    byte Dia,
    int BloqueInicio,
    int Duracion,
    string MateriaClave,
    string Materia,
    string Docente,
    string Grupo,
    string Carrera,
    string Modalidad,
    string Espacio,
    DateOnly FechaInicio,
    DateOnly FechaFin);
  private sealed record BloqueHorario(
    byte Dia,
    int BloqueInicio,
    int Duracion,
    EventoHorario[] Eventos);
}
