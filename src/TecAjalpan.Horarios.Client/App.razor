<CascadingAuthenticationState>
    <Router AppAssembly="@typeof(App).Assembly">
        <Found Context="routeData">
            <AuthorizeRouteView RouteData="@routeData" DefaultLayout="@typeof(MainLayout)">
                <NotAuthorized>
                    <RedirigirALogin />
                </NotAuthorized>
                <Authorizing>
                    <div class="carga-inicial">Validando sesión…</div>
                </Authorizing>
            </AuthorizeRouteView>
            <FocusOnNavigate RouteData="@routeData" Selector="h1" />
        </Found>
        <NotFound>
            <LayoutView Layout="@typeof(LoginLayout)">
                <PageTitle>Página no encontrada | Horarios Tec Ajalpan</PageTitle>
                <main class="not-found-page">
                    <section class="not-found-card">
                        <div class="login-logo">TA</div>
                        <span class="eyebrow">Error 404</span>
                        <h1>Página no encontrada</h1>
                        <p>La dirección que intentaste abrir no existe o ya no está disponible.</p>
                        <a class="btn-primary" href="/">Volver al panel</a>
                    </section>
                </main>
            </LayoutView>
        </NotFound>
    </Router>
</CascadingAuthenticationState>


